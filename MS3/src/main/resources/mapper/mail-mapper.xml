<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ms3.mapper.MailMapper">

    <resultMap id="mail" type="com.ms3.dto.MailDTO">
        <id property="mailNo" column="MAIL_NO" />
        <result property="sender" column="sender" />
        <result property="receiver" column="receiver" />
        <result property="subject" column="subject" />
        <result property="content" column="content" />
        <result property="writeDate" column="WRITE_DATE" />
    </resultMap>

    <select id="selectMail" resultMap="mail" parameterType="string">
        SELECT mail_no, sender, receiver, subject, content, write_date
        FROM MAILBOX
        WHERE receiver = #{userId}
    </select>

    <insert id="sendMail" parameterType="com.ms3.dto.MailDTO">
        INSERT INTO MAILBOX (sender, receiver, subject, content)
        VALUES (#{sender}, #{receiver}, #{subject}, #{content})
    </insert>

    <delete id="deleteMail" parameterType="int">
        DELETE FROM MAILBOX WHERE mail_No = #{mailNo}
    </delete>
    
    <select id="selectMailDetail" resultMap="mail" parameterType="map">
        SELECT mail_no, sender, receiver, subject, content, write_date
        FROM MAILBOX
        WHERE mail_No = #{mailNo} AND receiver = #{userId}
    </select>
    
</mapper>